# =============================================================================
# BEGINNER GUIDE (READ FIRST)
# =============================================================================
# This file is the master template.
# Copy this file to .env, then edit only values on the right side of '='.
#
# Format rule:
#   KEY=value
# Do not add spaces around '='.
#
# Simple safety rule:
# - If you are new, keep most defaults unchanged.
# - Only edit broker credentials + PAPER_TRADING + risk keys first.
#
# -------------------------
# FULL KEY GLOSSARY
# -------------------------
# ANGEL_CLIENT_ID: Broker login ID.
# ANGEL_PASSWORD: Broker login password.
# ANGEL_API_KEY: Broker API key.
# ANGEL_TOTP_SECRET: TOTP seed for 2FA login.
# PAPER_TRADING: true = simulated orders, false = live orders.
# USE_LIVE_DATA: true = broker/real feed, false = test/local feed.
# ENABLE_WEBSOCKET: true = fast live stream, false = no stream.
# TEST_MODE: true = internal testing behavior.
# TOTAL_CAPITAL: Starting capital used for risk math.
# RISK_PER_TRADE_PCT: % capital risk per trade (base).
# MAX_DAILY_LOSS: Rupee hard stop for full day.
# MAX_DAILY_LOSS_PCT: Daily loss stop as % capital.
# DAILY_LOSS_ALERT: Alert level before max daily loss.
# PROFIT_LOCK_THRESHOLD: Profit level after which safety tightening can apply.
# SYMBOL: Underlying symbol (example NIFTY).
# EXCHANGE: Exchange segment (example NFO).
# OPTION_TYPE: Default option side seed (CE/PE).
# LOT_SIZE: Contract lot size.
# NUM_LOTS: Base lot multiplier for legacy sizing path.
# CE_QUANTITY: CE quantity per order (fixed path baseline).
# PE_QUANTITY: PE quantity per order (fixed path baseline).
# SL_POINTS: Stop-loss in option points.
# TP_POINTS: Take-profit in option points.
# TP_MULTIPLIER: Minimum TP to SL ratio helper.
# TSL_ENABLED: Enables trailing stop.
# TSL_LEVELS: Trailing map in format profit:locked_profit pairs.
# TSL_BREAKEVEN_ACTIVATION: Profit points to shift into breakeven logic.
# EXIT_HARD_SL_POINTS: Hard loss cutoff points.
# EXIT_BREAKEVEN_TRIGGER_POINTS: Profit trigger for breakeven step.
# EXIT_BREAKEVEN_BUFFER_POINTS: Locked points near breakeven.
# EXIT_TRAILING_DISTANCE_POINTS: Gap used in trailing stop.
# EXIT_EARLY_LOSS_CUT_POINTS: Early adverse move cutoff points.
# EXIT_EARLY_LOSS_CUT_TIME_SEC: Time window for early adverse cutoff.
# EXIT_EARLY_CUT_ATR_LOW_POINTS: Early cut threshold in low volatility.
# EXIT_EARLY_CUT_ATR_HIGH_POINTS: Early cut threshold in high volatility.
# EXIT_SOFT_LOSS_TIME_SEC: Time limit for soft loss timeout exit.
# EXIT_SOFT_LOSS_POINTS: Mild loss threshold for timeout exit.
# RSI_REVERSAL_MIN_PROFIT_POINTS: Minimum profit (points) before RSI reversal exit locks gains.
# ATR_SL_HIGH_THRESHOLD: ATR above this widens SL/TP for the trade.
# ATR_SL_LOW_THRESHOLD: ATR below this tightens SL/TP for the trade.
# ATR_HIGH_SL_ADJUSTMENT: Points added to SL when ATR is high.
# ATR_HIGH_TP_ADJUSTMENT: Points added to TP when ATR is high.
# ATR_LOW_SL_ADJUSTMENT: Points removed from SL when ATR is low.
# ATR_LOW_TP_ADJUSTMENT: Points removed from TP when ATR is low.
# ATR_SL_MIN_POINTS: SL floor when ATR is low.
# ATR_TP_MIN_POINTS: TP floor when ATR is low.
# RSI_OVERBOUGHT: RSI level that force-exits a CE position.
# RSI_OVERSOLD: RSI level that force-exits a PE position.
# RSI_EXIT_MIN_PROFIT_POINTS: Minimum profit before RSI overbought/oversold exit is evaluated.
# RSI_REVERSAL_CE_EXIT: CE exits once RSI drops back below this after an extreme.
# RSI_REVERSAL_PE_EXIT: PE exits once RSI rises back above this after an extreme.
# RSI_REVERSAL_CE_EXTREME: RSI must have exceeded this before a CE reversal counts.
# RSI_REVERSAL_PE_EXTREME: RSI must have dropped below this before a PE reversal counts.
# MIN_SCORE: Minimum strategy score to consider entry.
# MIN_CONFIDENCE: Minimum confidence to allow entry.
# MIN_CONFIDENCE_AFTER_3SL: Higher confidence after losing streak.
# MAX_CONFIDENCE_SCORE: Score normalizer ceiling.
# MIN_ENTRY_PREMIUM: Minimum option premium to allow entry.
# MAX_ENTRY_PREMIUM: Maximum option premium to allow entry.
# STRIKE_PREMIUM_MIN: Minimum premium used when selecting which strike to trade.
# STRIKE_PREMIUM_MAX: Maximum premium used when selecting which strike to trade.
# MAX_TRADES_PER_DAY: Daily trade count cap.
# MAX_TRADES_PER_HOUR: Hourly trade count cap.
# IDEAL_TRADES_PER_DAY: Guidance target for strategy behavior.
# REQUIRE_CONSECUTIVE_SIGNALS: Number of consecutive same-direction signals (within 5s) required before entry.
#
# POSITION SIZE ENGINE (core/engines/position_size_engine.py) — decides real trade quantity.
# POS_SIZE_DEFAULT/MIN/MAX_RISK_PCT: Base risk-budget % of capital used per trade (before adjustments).
# POS_SIZE_WEIGHT_*: How much each factor (score/confidence/market quality/regime/volatility/recovery/daily loss) shifts allocation.
# POS_SIZE_ALLOC_CLAMP_MIN/MAX: Final allocation multiplier floor/ceiling after all adjustments.
# POS_SIZE_RANGE_*_MIN/MAX: Per-factor multiplier range each weight is scaled into.
# POS_SIZE_MAX_CAPITAL_ALLOCATION_PCT: Hard cap on capital committed to one trade.
# POS_SIZE_MAX_SYMBOL_DAILY_RISK_PCT: Hard cap on one symbol's share of the daily risk budget.
# POS_SIZE_MAX_LOTS: This engine's own lot cap (the only lot cap now — legacy MAX_LOTS/MIN_LOTS were removed as dead code).
# POS_SIZE_MIN_EXECUTABLE_QTY: Below this, position size is zeroed instead of rounded up.
# POS_SIZE_ENFORCE_LOT_ROUNDING: Whether quantity must round to whole lots.
# POS_SIZE_DAILY_RISK_CAP_PCT: Hard cap on risk amount as % of capital for one trade.
# POS_SIZE_RECOVERY_MODE_CAP_PCT: Capital allocation cap while recovery mode is active.
# POS_SIZE_MIN_LOT_ROUNDING_TOLERANCE_PCT: How far short of 1 lot's cost the budget can be and still round up to 1 lot.
# POS_SIZE_GRADE_A_PLUS/A/B/C: Allocation-multiplier cutoffs for the A+/A/B/C sizing grade shown in logs.
# MAX_HOLD_TIME_SEC: Max hold for normal day.
# MAX_HOLD_TIME_EXPIRY_SEC: Max hold for expiry day.
# CONSECUTIVE_LOSS_LIMIT: Loss streak threshold.
# COOLDOWN_NORMAL: Cooldown seconds after normal close.
# COOLDOWN_AFTER_PROFIT: Cooldown after profitable exit.
# COOLDOWN_AFTER_SL: Cooldown after stop-loss exit.
# COOLDOWN_AFTER_CONSEC_LOSS: Longer cooldown after streak.
# COOLDOWN_NON_TRADE_BLOCK: Short cooldown after a blocked entry that never risked capital (risk gate, execution-drift skip, zero position size, order failure).
# KILL_SWITCH_ENABLED: Enables hard trading shutdown checks.
# KILL_SWITCH_LOSS: Kill switch loss trigger in rupees.
# KILL_SWITCH_CONSEC_LOSS: Kill switch streak trigger.
# KILL_SWITCH_SPREAD_PCT: Kill switch spread trigger.
# KILL_SWITCH_LATENCY_MS: Kill switch latency trigger.
# LATENCY_LIMIT_MS: Normal latency quality limit.
# SPREAD_LIMIT_PCT: Maximum spread allowed in checks.
# TICK_TIMEOUT_SEC: Tick freshness timeout.
# MIN_VOLUME: Minimum volume quality threshold.
# MIN_OPTION_PRICE: Minimum tradable option price.
# MAX_OPTION_PRICE: Maximum tradable option price.
# WS_STALE_MS: Stale threshold for websocket ticks.
# REST_STALE_MS: Stale threshold for REST ticks.
# UNKNOWN_STALE_MS: Stale threshold fallback.
# DELTA_MIN / DELTA_MAX: Valid delta operating band.
# DELTA_KILL_MIN: Too-low delta kill threshold.
# GAMMA_NORMAL_MAX: Normal day gamma threshold.
# GAMMA_EXPIRY_MAX: Expiry day gamma threshold.
# THETA_SEC_LIMIT: Warning theta decay threshold.
# THETA_SEC_KILL: Hard theta kill threshold.
# EMA_FAST/EMA_SIGNAL/EMA_MEDIUM/EMA_SLOW: EMA periods.
# RSI_PERIOD: RSI period.
# MACD_FAST/MACD_SLOW/MACD_SIGNAL: MACD periods.
# BB_PERIOD/BB_STD: Bollinger settings.
# ATR_PERIOD: ATR period.
# USE_LIMIT_ORDERS: true = prefer limit entries/exits.
# LIMIT_ORDER_OFFSET: Limit offset from best quote.
# MAX_SLIPPAGE_PCT: Allowed slippage cap.
# ENTRY_SIGNAL_MAX_AGE_MS: Max delay between signal and execution.
# ENTRY_MAX_DRIFT_PCT: Max price drift allowed before skipping entry.
# ORDER_RETRY_ENABLED: Retry failed orders.
# ORDER_MAX_RETRIES: Retry count.
# ORDER_RETRY_DELAY_MS: Delay between retries.
# ORDER_PRICE_CHASE_STEP: Price step increase per retry.
# MARKET_OPEN / MARKET_CLOSE: Exchange session bounds.
# TRADING_START / TRADING_END: Strategy trading window.
# AVOID_FIRST_15MIN: Avoid noisy open session.
# TELEGRAM_*: Notification controls.
# DASHBOARD_ENABLED / DASHBOARD_PORT: Local dashboard.
# DATABASE_*: Trade/signal persistence controls.
# LOG_*: Logging controls.
# SESSION_FILTER_ENABLED: Enable configured session windows.
#
# -------------------------
# GUARD TUNING STEP-1 / STEP-2
# -------------------------
# STEP-1 (Collect data):
#   Run paper trading for at least 1 full session with guards ON.
#   Then generate report:
#   python -m core.validation.execution_guard_report --date YYYY-MM-DD \
#     --output logs/readiness/YYYY-MM-DD/execution_guard_report.json
#
# STEP-2 (Tune values):
#   If too many blocked entries:
#     ENTRY_MAX_DRIFT_PCT: 0.35 -> 0.40 or 0.45
#     ENTRY_SIGNAL_MAX_AGE_MS: 2500 -> 3000
#   If chasing still happens:
#     ENTRY_MAX_DRIFT_PCT: 0.35 -> 0.25
#     ENTRY_SIGNAL_MAX_AGE_MS: 2500 -> 1800
# =============================================================================

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    PTQ SCALPING BOT - CONFIGURATION                          ║
# ║                     Copy this to .env and fill values                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# 🔐 BROKER CREDENTIALS (Get from Angel One)
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_API_KEY=your_api_key
ANGEL_TOTP_SECRET=your_totp_secret

# 💰 TRADING MODE
PAPER_TRADING=true
USE_LIVE_DATA=false
ENABLE_WEBSOCKET=true
TEST_MODE=false

# 💵 CAPITAL SETTINGS
TOTAL_CAPITAL=30000
RISK_PER_TRADE_PCT=3
MAX_DAILY_LOSS=2500
MAX_DAILY_LOSS_PCT=10.0
DAILY_LOSS_ALERT=1500
PROFIT_LOCK_THRESHOLD=1000

# 📊 INSTRUMENT
SYMBOL=NIFTY
EXCHANGE=NFO
OPTION_TYPE=CE
LOT_SIZE=65
NUM_LOTS=4

# 📊 POSITION SIZING
CE_QUANTITY=65
PE_QUANTITY=65

# Position Size Engine (core/engines/position_size_engine.py) — the risk
# allocator that decides real trade quantity.
POS_SIZE_DEFAULT_RISK_PCT=0.01
POS_SIZE_MIN_RISK_PCT=0.002
POS_SIZE_MAX_RISK_PCT=0.02
POS_SIZE_WEIGHT_SCORE=0.18
POS_SIZE_WEIGHT_CONFIDENCE=0.18
POS_SIZE_WEIGHT_MARKET_QUALITY=0.18
POS_SIZE_WEIGHT_REGIME=0.12
POS_SIZE_WEIGHT_VOLATILITY=0.14
POS_SIZE_WEIGHT_RECOVERY=0.10
POS_SIZE_WEIGHT_DAILY_LOSS=0.10
POS_SIZE_ALLOC_CLAMP_MIN=0.40
POS_SIZE_ALLOC_CLAMP_MAX=1.10
POS_SIZE_RANGE_SCORE_MIN=0.80
POS_SIZE_RANGE_SCORE_MAX=1.10
POS_SIZE_RANGE_CONFIDENCE_MIN=0.80
POS_SIZE_RANGE_CONFIDENCE_MAX=1.10
POS_SIZE_RANGE_MARKET_QUALITY_MIN=0.75
POS_SIZE_RANGE_MARKET_QUALITY_MAX=1.10
POS_SIZE_RANGE_REGIME_MIN=0.85
POS_SIZE_RANGE_REGIME_MAX=1.05
POS_SIZE_RANGE_VOLATILITY_MIN=0.70
POS_SIZE_RANGE_VOLATILITY_MAX=1.00
POS_SIZE_RANGE_RECOVERY_MIN=0.50
POS_SIZE_RANGE_RECOVERY_MAX=1.00
POS_SIZE_RANGE_DAILY_LOSS_MIN=0.40
POS_SIZE_RANGE_DAILY_LOSS_MAX=1.00
POS_SIZE_MAX_CAPITAL_ALLOCATION_PCT=0.20
POS_SIZE_MAX_SYMBOL_DAILY_RISK_PCT=0.40
POS_SIZE_MAX_LOTS=8
POS_SIZE_MIN_EXECUTABLE_QTY=1
POS_SIZE_ENFORCE_LOT_ROUNDING=true
POS_SIZE_DAILY_RISK_CAP_PCT=0.03
POS_SIZE_RECOVERY_MODE_CAP_PCT=0.50
POS_SIZE_MIN_LOT_ROUNDING_TOLERANCE_PCT=0.05
POS_SIZE_GRADE_A_PLUS=1.02
POS_SIZE_GRADE_A=0.95
POS_SIZE_GRADE_B=0.85
POS_SIZE_GRADE_C=0.70

# 🛑 STOP LOSS / TAKE PROFIT
SL_POINTS=7
TP_POINTS=14
TP_MULTIPLIER=2.0

# ATR-adaptive SL/TP widening
ATR_SL_HIGH_THRESHOLD=8
ATR_SL_LOW_THRESHOLD=4
ATR_HIGH_SL_ADJUSTMENT=1
ATR_HIGH_TP_ADJUSTMENT=2
ATR_LOW_SL_ADJUSTMENT=1
ATR_LOW_TP_ADJUSTMENT=2
ATR_SL_MIN_POINTS=4
ATR_TP_MIN_POINTS=10

# Smart RSI exit thresholds
RSI_OVERBOUGHT=80
RSI_OVERSOLD=20
RSI_EXIT_MIN_PROFIT_POINTS=2.0
RSI_REVERSAL_CE_EXIT=60
RSI_REVERSAL_PE_EXIT=40
RSI_REVERSAL_CE_EXTREME=75
RSI_REVERSAL_PE_EXTREME=25

# 📈 TRAILING STOP LOSS
TSL_ENABLED=true
TSL_LEVELS=8:4,12:7,16:11,20:15,25:20,30:25,40:35,50:45
TSL_BREAKEVEN_ACTIVATION=5
EXIT_HARD_SL_POINTS=7
EXIT_BREAKEVEN_TRIGGER_POINTS=4
EXIT_BREAKEVEN_BUFFER_POINTS=2
EXIT_TRAILING_DISTANCE_POINTS=2.5
EXIT_EARLY_LOSS_CUT_POINTS=3.5
EXIT_EARLY_LOSS_CUT_TIME_SEC=45
EXIT_EARLY_CUT_ATR_LOW_POINTS=2.5
EXIT_EARLY_CUT_ATR_HIGH_POINTS=4.5
EXIT_SOFT_LOSS_TIME_SEC=75
EXIT_SOFT_LOSS_POINTS=1.8
RSI_REVERSAL_MIN_PROFIT_POINTS=1.5

# 📊 STRATEGY SCORING
MIN_SCORE=4
MIN_CONFIDENCE=70
MIN_CONFIDENCE_AFTER_3SL=85
MAX_CONFIDENCE_SCORE=11
MIN_ENTRY_PREMIUM=70
MAX_ENTRY_PREMIUM=350
STRIKE_PREMIUM_MIN=70
STRIKE_PREMIUM_MAX=350

# ⏱️ TRADING LIMITS
MAX_TRADES_PER_DAY=30
MAX_TRADES_PER_HOUR=10
IDEAL_TRADES_PER_DAY=8
REQUIRE_CONSECUTIVE_SIGNALS=1

# ⏱️ HOLD / COOLDOWN
MAX_HOLD_TIME_SEC=900
MAX_HOLD_TIME_EXPIRY_SEC=600
CONSECUTIVE_LOSS_LIMIT=2
COOLDOWN_NORMAL=120
COOLDOWN_AFTER_PROFIT=30
COOLDOWN_AFTER_SL=120
COOLDOWN_AFTER_CONSEC_LOSS=900
COOLDOWN_NON_TRADE_BLOCK=15

# 🚨 KILL SWITCH
KILL_SWITCH_ENABLED=true
KILL_SWITCH_LOSS=600
KILL_SWITCH_CONSEC_LOSS=5
KILL_SWITCH_SPREAD_PCT=0.6
KILL_SWITCH_LATENCY_MS=1500

# 🧹 DATA HYGIENE
LATENCY_LIMIT_MS=100
SPREAD_LIMIT_PCT=2.5
TICK_TIMEOUT_SEC=3
MIN_VOLUME=100
MIN_OPTION_PRICE=1
MAX_OPTION_PRICE=500
WS_STALE_MS=10000
REST_STALE_MS=5000
UNKNOWN_STALE_MS=2000

# 📐 GREEKS LIMITS
DELTA_MIN=0.25
DELTA_MAX=0.80
DELTA_KILL_MIN=0.15
GAMMA_NORMAL_MAX=0.08
GAMMA_EXPIRY_MAX=0.12
THETA_SEC_LIMIT=0.2
THETA_SEC_KILL=0.3

# 📊 INDICATORS
EMA_FAST=5
EMA_SIGNAL=9
EMA_MEDIUM=21
EMA_SLOW=50
RSI_PERIOD=18
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
ATR_PERIOD=14

# 🧾 ORDER EXECUTION
USE_LIMIT_ORDERS=true
LIMIT_ORDER_OFFSET=0.25
MAX_SLIPPAGE_PCT=0.5
ENTRY_SIGNAL_MAX_AGE_MS=2500
ENTRY_MAX_DRIFT_PCT=0.75
ORDER_RETRY_ENABLED=true
ORDER_MAX_RETRIES=3
ORDER_RETRY_DELAY_MS=500
ORDER_PRICE_CHASE_STEP=0.5

# ⏰ MARKET HOURS
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
TRADING_START=09:20
TRADING_END=15:10
AVOID_FIRST_15MIN=true

# 📱 TELEGRAM (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_NOTIFY_ENTRIES=true
TELEGRAM_NOTIFY_EXITS=true
TELEGRAM_NOTIFY_KILL_SWITCH=true
TELEGRAM_DAILY_SUMMARY=true

# 🖥️ DASHBOARD
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# 💾 DATABASE
DATABASE_ENABLED=true
DATABASE_PATH=data/trades.db
DATABASE_LOG_SIGNALS=true
DATABASE_LOG_TICKS=false

# 📝 LOGGING
LOG_ENABLED=true
LOG_CONSOLE=true
LOG_DIRECTORY=logs
LOG_VERBOSE=false

# 🗓️ SESSION FILTER
SESSION_FILTER_ENABLED=true

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    PTQ SCALPING BOT - CONFIGURATION                          ║
# ║                     Copy this to .env and fill values                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# 🔐 BROKER CREDENTIALS (Get from Angel One)
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_API_KEY=your_api_key
ANGEL_TOTP_SECRET=your_totp_secret

# 💰 TRADING MODE
PAPER_TRADING=true
USE_LIVE_DATA=false
ENABLE_WEBSOCKET=true
TEST_MODE=false

# 💵 CAPITAL SETTINGS
TOTAL_CAPITAL=30000
RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS=1500
MAX_DAILY_LOSS_PCT=5.0
DAILY_LOSS_ALERT=1000
PROFIT_LOCK_THRESHOLD=1000

# 📊 INSTRUMENT
SYMBOL=NIFTY
EXCHANGE=NFO
OPTION_TYPE=CE
LOT_SIZE=65
NUM_LOTS=4

# 📊 POSITION SIZING
CE_QUANTITY=65
PE_QUANTITY=65
POSITION_SIZING_ENABLED=true
POSITION_SIZING_METHOD=risk_based
MAX_LOTS=2
MIN_LOTS=1

# 🛑 STOP LOSS / TAKE PROFIT
SL_POINTS=6
TP_POINTS=12
TP_MULTIPLIER=2.0

# 📈 TRAILING STOP LOSS
TSL_ENABLED=true
TSL_LEVELS=8:4,12:7,16:11,20:15,25:20,30:25,40:35,50:45
TSL_BREAKEVEN_ACTIVATION=5

# 📊 STRATEGY SCORING
MIN_SCORE=4
MIN_CONFIDENCE=70
MIN_CONFIDENCE_AFTER_3SL=85
MAX_CONFIDENCE_SCORE=11
MIN_ENTRY_PREMIUM=90
MAX_ENTRY_PREMIUM=350

# ⏱️ TRADING LIMITS
MAX_TRADES_PER_DAY=15
MAX_TRADES_PER_HOUR=10
IDEAL_TRADES_PER_DAY=8

# ⏱️ HOLD / COOLDOWN
MAX_HOLD_TIME_SEC=900
MAX_HOLD_TIME_EXPIRY_SEC=600
CONSECUTIVE_LOSS_LIMIT=2
COOLDOWN_NORMAL=180
COOLDOWN_AFTER_PROFIT=120
COOLDOWN_AFTER_SL=300
COOLDOWN_AFTER_CONSEC_LOSS=1200

# 🚨 KILL SWITCH
KILL_SWITCH_ENABLED=true
KILL_SWITCH_LOSS=450
KILL_SWITCH_CONSEC_LOSS=3
KILL_SWITCH_SPREAD_PCT=0.6
KILL_SWITCH_LATENCY_MS=100

# 🧹 DATA HYGIENE
LATENCY_LIMIT_MS=100
SPREAD_LIMIT_PCT=2.5
TICK_TIMEOUT_SEC=2
MIN_VOLUME=100
MIN_OPTION_PRICE=5
MAX_OPTION_PRICE=500
WS_STALE_MS=10000
REST_STALE_MS=5000
UNKNOWN_STALE_MS=2000

# 📐 GREEKS LIMITS
DELTA_MIN=0.25
DELTA_MAX=0.75
DELTA_KILL_MIN=0.15
GAMMA_NORMAL_MAX=0.08
GAMMA_EXPIRY_MAX=0.12
THETA_SEC_LIMIT=0.2
THETA_SEC_KILL=0.3

# 📊 INDICATORS
EMA_FAST=5
EMA_SIGNAL=9
EMA_MEDIUM=21
EMA_SLOW=50
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
ATR_PERIOD=14

# 🧾 ORDER EXECUTION
USE_LIMIT_ORDERS=true
LIMIT_ORDER_OFFSET=0.25
MAX_SLIPPAGE_PCT=0.5
ORDER_RETRY_ENABLED=true
ORDER_MAX_RETRIES=3
ORDER_RETRY_DELAY_MS=500
ORDER_PRICE_CHASE_STEP=0.5

# ⏰ MARKET HOURS
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
TRADING_START=09:20
TRADING_END=15:10
AVOID_FIRST_15MIN=true

# 📱 TELEGRAM (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_NOTIFY_ENTRIES=true
TELEGRAM_NOTIFY_EXITS=true
TELEGRAM_NOTIFY_KILL_SWITCH=true
TELEGRAM_DAILY_SUMMARY=true

# 🖥️ DASHBOARD
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080

# 💾 DATABASE
DATABASE_ENABLED=true
DATABASE_PATH=data/trades.db
DATABASE_LOG_SIGNALS=true
DATABASE_LOG_TICKS=false

# 📝 LOGGING
LOG_ENABLED=true
LOG_CONSOLE=true
LOG_DIRECTORY=logs
LOG_VERBOSE=false

# 🗓️ SESSION FILTER
SESSION_FILTER_ENABLED=true
